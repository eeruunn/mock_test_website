generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attempts     Attempt[]
}

model ExamCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  exams       Exam[]
}

model Exam {
  id                 String       @id @default(uuid())
  categoryId         Int
  category           ExamCategory @relation(fields: [categoryId], references: [id])
  title              String
  slug               String       @unique
  description        String?
  totalDurationMin   Int
  totalMarks         Float
  negativeMarking    Float        @default(0)
  isFree             Boolean      @default(true)
  isPublished        Boolean      @default(false)
  sections           Section[]
  attempts           Attempt[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Section {
  id           String     @id @default(uuid())
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  name         String
  orderIndex   Int
  durationMin  Int?
  totalMarks   Float
  questions    Question[]
}

model Question {
  id                String            @id @default(uuid())
  sectionId         String
  section           Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questionType      String            @default("mcq_single") // 'mcq_single', 'mcq_multi', 'numeric'
  questionText      String
  questionImageUrl  String?
  marks             Float             @default(1)
  negativeMarks     Float             @default(0)
  difficulty        String            @default("medium") // 'easy', 'medium', 'hard'
  explanation       String?
  tags              String[]
  options           QuestionOption[]
  responses         Response[]
  createdAt         DateTime          @default(now())
}

model QuestionOption {
  id              String    @id @default(uuid())
  questionId      String
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText      String
  optionImageUrl  String?
  isCorrect       Boolean   @default(false)
  orderIndex      Int
}

model Attempt {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  examId       String
  exam         Exam       @relation(fields: [examId], references: [id])
  status       String     @default("in_progress") // 'in_progress', 'submitted', 'expired'
  startedAt    DateTime   @default(now())
  submittedAt  DateTime?
  expiresAt    DateTime?
  responses    Response[]
  result       Result?
}

model Response {
  id                  String    @id @default(uuid())
  attemptId           String
  attempt             Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question  @relation(fields: [questionId], references: [id])
  selectedOptionIds   String[]
  numericAnswer       Float?
  isFlagged           Boolean   @default(false)
  timeSpentSec        Int       @default(0)
  isCorrect           Boolean?
  marksAwarded        Float?
  answeredAt          DateTime  @default(now())

  @@unique([attemptId, questionId])
}

model Result {
  id                  String    @id @default(uuid())
  attemptId           String    @unique
  attempt             Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalMarksScored    Float
  totalCorrect        Int
  totalWrong          Int
  totalUnattempted    Int
  sectionBreakdown    Json
  percentile          Float?
  computedAt          DateTime  @default(now())
}